{
  "name": "@dreckly/api-gateway",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api-gateway",
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api-gateway:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api-gateway:build:development"
          },
          "production": {
            "buildTarget": "api-gateway:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@dreckly/data-access": "*",
    "@dreckly/shared-types": "*",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4"
  }
}
